# --- Cloudflare Access authentication ---
# Live mode fails closed unless the collector validates a Cloudflare Access JWT.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_ACCESS_REQUIRED=true
# Optional issuer claim validation. Leave blank unless your Access tenant requires it.
CLOUDFLARE_ACCESS_ISSUER=

# --- Application / evidence secrets ---
APP_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES

# --- EDR selection ---
EDR_PROVIDER=crowdstrike

# --- CrowdStrike ---
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
FALCON_CLOUD=us-1
RTR_POLL_INTERVAL=2
RTR_COMMAND_TIMEOUT=900

# --- SentinelOne ---
SENTINELONE_BASE_URL=https://your-console.sentinelone.net
SENTINELONE_API_TOKEN=
SENTINELONE_HTTP_TIMEOUT=60
S1_EXECUTION_MODE=remote_script
S1_REMOTE_SCRIPT_ID=
S1_REMOTE_SCRIPT_TIMEOUT=1800
S1_PACKAGE_BASE_URL=https://your-collector.example.com
S1_FETCH_TIMEOUT=900
# No S1_FETCH_PASSWORD: each GUI collection push generates one fresh 32-character password.

# --- Local persistence / evidence ---
COLLECTOR_DB_PATH=./evidence-collector.db
EVIDENCE_DIR=./uploads/collections
EVIDENCE_RETENTION_DAYS=30
JOB_WORKERS=2
EVIDENCE_ENCRYPTION_KEY=CHANGE_ME_BASE64_URLSAFE_32_BYTE_KEY


# --- Cross-platform one-time collectors ---
# Windows, Linux, and macOS use server-managed Velociraptor offline collectors.
S1_REMOTE_SCRIPT_ID_WINDOWS=
S1_REMOTE_SCRIPT_ID_LINUX=
S1_REMOTE_SCRIPT_ID_MACOS=
VELOCIRAPTOR_COLLECTOR_ROOT=./velociraptor/collectors

# --- Velociraptor ---
# Local Docker server for managing/building one-time offline collectors.
VELOCIRAPTOR_VERSION=0.77.1
VELOCIRAPTOR_HOSTNAME=127.0.0.1
VELOCIRAPTOR_GUI_HOST_PORT=8889
VELOCIRAPTOR_FRONTEND_HOST_PORT=8001
VELOCIRAPTOR_INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
VELOCIRAPTOR_SERVER_URL=https://127.0.0.1:8889
# Optional server-side maintenance command invoked by the Settings update button.
# The command receives VELOCIRAPTOR_LATEST_VERSION in its environment.
# Example when the application process can invoke a trusted host maintenance wrapper:
# VELOCIRAPTOR_UPDATE_COMMAND=./scripts/update_velociraptor.sh
VELOCIRAPTOR_UPDATE_COMMAND=

# CrowdStrike RTR transport archive password. Server-side only; never shown in the GUI or audit log.
CROWDSTRIKE_RTR_ARCHIVE_PASSWORD=infected

# --- Tenable Vulnerability Management / Asset Coverage ---
TENABLE_BASE_URL=https://cloud.tenable.com
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
TENABLE_HTTP_TIMEOUT=60
TENABLE_VULN_EXPORT_TIMEOUT_SECONDS=1800
TENABLE_ASSET_LIST_LIMIT=5000
ASSET_SYNC_CHUNK_SIZE=5000
# Asset inventory sync schedule: 00:00, 06:00, 12:00, and 18:00 in the server/container local timezone.

# Application authentication / RBAC
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
# First-run only: create the initial administrator, then remove the password from .env.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_12_PLUS_CHARACTERS
